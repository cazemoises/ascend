# PostgreSQL
POSTGRES_USER=ascend
POSTGRES_PASSWORD=ascend
POSTGRES_DB=ascend

# Database URL (for running migrations from host; docker-compose uses postgres hostname internally)
DATABASE_URL=postgres://ascend:ascend@localhost:5432/ascend?sslmode=disable

# API server
API_ADDR=0.0.0.0:8080
# HS256 signing key; must be at least 32 bytes (generate: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-32+byte-secret!!

# Submission rate limit: max requests per user per sliding window
SUBMIT_RATE_LIMIT=10
SUBMIT_RATE_WINDOW_S=60

# Redis (for running judge from host; docker-compose uses redis hostname internally)
REDIS_ADDR=localhost:6379
